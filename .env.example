# Copy to `.env` (development machine) or to `/etc/spotify-to-led/env` (the Pi,
# owner-only, mode 0600) and fill in. Keys are case-insensitive and unprefixed;
# see src/spotify_to_led/config.py. Commented-out keys show their defaults.
#
# On the Pi, ecosystem.config.js selects that file by setting
# SPOTIFY_TO_LED_ENV_FILE, which must name a file that exists. The Pi's file
# must also set BOARD_TRANSPORT=idotmatrix and IDOT_MAC, or the service drives
# the stub instead of the board.

# --- Board ------------------------------------------------------------------

# `stub` writes frames to PNGs in STUB_FRAME_DIR; `idotmatrix` drives the real
# board over Bluetooth and then requires IDOT_MAC.
# BOARD_TRANSPORT=stub
# IDOT_MAC=AA:BB:CC:DD:EE:FF
# BOARD_SIZE=32                  # one of 16, 32, 64
# BOARD_HEARTBEAT_SECONDS=30
# STUB_FRAME_DIR=var/frames

# --- Server -----------------------------------------------------------------

# Keep 127.0.0.1: on the Pi the Cloudflare connector runs on the same machine
# and reaches the app over loopback. 0.0.0.0 would expose it to the LAN without
# the Cloudflare Access gate.
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO

# --- Spotify ----------------------------------------------------------------

# Client ID of the dedicated Spotify Development Mode app. No client secret:
# the PKCE flow never sends it, so it stays in the Spotify dashboard. Left
# empty, the service runs no Spotify reader and the redirect URI is ignored.
SPOTIFY_CLIENT_ID=
# Must match the redirect URI registered in the Spotify app character for
# character: https, the Cloudflare-published subdomain, `/callback`, no port,
# no trailing slash. This is the only place the public hostname appears.
SPOTIFY_REDIRECT_URI=https://led.example.com/callback
# Where the service itself writes the token set after /authorize, rewritten on
# every refresh. Runtime state, not configuration: never put a token here.
# SPOTIFY_TOKEN_FILE=var/spotify-token.json
